## Interface: 30300
## Title: Improved Raid Frames
## Notes: Extends Compact Raid Frames with aura indicators, heal prediction, a taint-free unit menu, Ctrl-click focus and raid performance improvements
## Author: EvilTactician (based on Enhanced Raid Frames by Britt W. Yazel and Compact Raid Frames by Tsoukie)
## Version: 1.0.1
## DefaultState: enabled
## SavedVariables: ImprovedRaidFramesDB
## RequiredDeps: !!!ClassicAPI, CompactRaidFrame
## OptionalDeps: Clique

# Libraries
Libs\embeds.xml

# Locales
Localizations\Localizations.xml

# Core
ImprovedRaidFrames.lua
Globals.lua
DatabaseDefaults.lua

# Utils
Utils\Utilities.lua
Utils\DatabaseMigration.lua

# Frame registry and shared event handling (must load before the modules that use it)
Modules\FrameRegistry.lua
Overrides.lua

# Aura Indicators
Modules\AuraListeners.lua
Modules\AuraIndicators.lua

# Target Markers
Modules\TargetMarkers.lua

# Heal Prediction
Modules\HealPrediction.lua
Modules\BotHeals.lua

# Unit Menu and Focus
Modules\UnitMenu.lua
Modules\Focus.lua

# Templates
XML\IndicatorTemplate.xml

# GUI
GUI\GeneralConfigPanel.lua
GUI\IndicatorConfigPanel.lua
GUI\TargetMarkerConfigPanel.lua
GUI\HealPredictionConfigPanel.lua
GUI\ProfileImportExport.lua
